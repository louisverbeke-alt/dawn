{%- liquid
  assign companion_handle = nil
  assign companion_blurb = nil
  assign companion_link_text = nil

  case product.handle
    when 'the-menopause-strength-blueprint'
      assign companion_handle = 'the-glp-1-companion-nutrition-muscle-retention-guide'
      assign companion_blurb = "If you're also managing your weight or appetite alongside your fitness goals, the GLP-1 Companion covers the nutrition side in the same practical, plain-English style."
      assign companion_link_text = "View the GLP-1 Companion →"
    when 'the-glp-1-companion-nutrition-muscle-retention-guide'
      assign companion_handle = 'the-menopause-strength-blueprint'
      assign companion_blurb = "Nutrition and movement work best together. The Menopause Strength Blueprint gives you the training structure to protect your muscle while you're in a calorie deficit."
      assign companion_link_text = "View the Menopause Strength Blueprint →"
  endcase
-%}

{%- if companion_handle -%}
  {%- assign companion = all_products[companion_handle] -%}
  {%- if companion and companion.available -%}
    <div class="color-{{ section.settings.color_scheme }} gradient" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
      <div class="page-width">
        <div style="border: 1px solid rgba(var(--color-foreground), 0.12); border-radius: 4px; padding: 1.5rem 2rem; display: flex; flex-direction: column; gap: 0.75rem;">
          <p style="font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase; opacity: 0.55; margin: 0;">Pairs well with</p>
          <div style="display: flex; flex-direction: column; gap: 0.4rem;">
            <p style="font-weight: 600; font-size: 1rem; margin: 0;">{{ companion.title }}</p>
            <p style="margin: 0; font-size: 0.95rem; line-height: 1.55; opacity: 0.8;">{{ companion_blurb }}</p>
          </div>
          <a href="{{ companion.url }}" class="link" style="font-size: 0.9rem; align-self: flex-start;">{{ companion_link_text }}</a>
        </div>
      </div>
    </div>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Pairs well with",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Pairs well with"
    }
  ]
}
{% endschema %}
