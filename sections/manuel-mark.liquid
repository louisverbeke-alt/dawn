{{ 'manuel-theme.css' | asset_url | stylesheet_tag }}

<footer class="mn mn-mark" role="contentinfo">

  {%- comment -%} Keurslager badge / ornament {%- endcomment -%}
  <svg width="48" height="48" viewBox="0 0 48 48" fill="none" aria-hidden="true" style="color: var(--mn-gold); opacity: 0.4; margin-bottom: 8px;">
    <circle cx="24" cy="24" r="20" stroke="currentColor" stroke-width="1"/>
    <circle cx="24" cy="24" r="14" stroke="currentColor" stroke-width="0.6"/>
    <path d="M24 10L25.5 18H34L27.5 22.5L30 31L24 26.5L18 31L20.5 22.5L14 18H22.5Z" fill="currentColor" opacity="0.8"/>
  </svg>

  <p class="mn-mark__sig">
    {{ section.settings.signature | default: 'Manuel &amp; Anoeshka' }}
  </p>
  <p class="mn-mark__sub">
    {{ section.settings.subline | default: 'Erkend Keurslager · Uw vakslager van vertrouwen' }}
  </p>
  <div class="mn-mark__keur">
    {{ section.settings.keur_label | default: 'Keurslager' }}
  </div>

  <div style="margin-top: 40px; padding-top: 28px; border-top: 1px solid rgba(240,230,214,0.07); display: flex; flex-wrap: wrap; justify-content: center; gap: 24px; font-family: var(--mn-sans); font-size: 11px; letter-spacing: 0.15em; color: rgba(240,230,214,0.22); text-transform: uppercase;">
    <span>© {{ 'now' | date: '%Y' }} Keurslager Manuel en Anoeshka</span>
    <a href="/pages/privacybeleid" style="color: inherit; text-decoration: none;">Privacybeleid</a>
    <a href="/pages/cookiebeleid" style="color: inherit; text-decoration: none;">Cookies</a>
  </div>

</footer>

{% schema %}
{
  "name": "Manuel · Mark",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "signature",  "label": "Handtekening / naam", "default": "Manuel & Anoeshka" },
    { "type": "text", "id": "subline",    "label": "Subline",             "default": "Erkend Keurslager · Uw vakslager van vertrouwen" },
    { "type": "text", "id": "keur_label", "label": "Badge tekst",         "default": "Keurslager" }
  ],
  "presets": [{ "name": "Manuel · Mark" }]
}
{% endschema %}
