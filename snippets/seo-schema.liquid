<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "{{ shop.url }}/#organization",
      "name": {{ shop.name | json }},
      "url": {{ shop.url | json }},
      "email": "guidecrafted@gmail.com",
      "logo": {
        "@type": "ImageObject",
        "url": "{{ shop.url }}/cdn/shop/files/guidecraft-logo.png"
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "email": "guidecrafted@gmail.com",
        "contactType": "customer support",
        "availableLanguage": "English"
      },
      "description": "GuideCraft sells practical downloadable PDF guides for women and moms aged 30–60, covering menopause, fitness, nutrition, parenting, and wellness.",
      "sameAs": [
        "{{ settings.social_pinterest_link }}",
        "{{ settings.social_instagram_link }}"
      ]
    },
    {
      "@type": "WebSite",
      "@id": "{{ shop.url }}/#website",
      "url": {{ shop.url | json }},
      "name": {{ shop.name | json }},
      "publisher": { "@id": "{{ shop.url }}/#organization" },
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "{{ shop.url }}/search?q={search_term_string}"
        },
        "query-input": "required name=search_term_string"
      }
    }
    {%- if request.page_type == 'index' -%}
    ,{
      "@type": "WebPage",
      "@id": "{{ shop.url }}/#webpage",
      "url": {{ shop.url | json }},
      "name": "Downloadable Wellness Guides for Women | GuideCraft",
      "description": "Practical downloadable PDF guides for women aged 30–60. Topics include menopause, fitness, nutrition, GLP-1 support, parenting, and self-improvement. Instant delivery.",
      "isPartOf": { "@id": "{{ shop.url }}/#website" },
      "about": { "@id": "{{ shop.url }}/#organization" },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": {{ shop.url | json }}
          }
        ]
      }
    }
    {%- endif -%}
    {%- if request.page_type == 'product' -%}
    ,{
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": {{ shop.url | json }}
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "All Guides",
          "item": "{{ shop.url }}/collections/all"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": {{ product.title | json }},
          "item": "{{ shop.url }}/products/{{ product.handle }}"
        }
      ]
    }
    ,{
      "@type": ["Product", "DigitalDocument"],
      "@id": "{{ shop.url }}/products/{{ product.handle }}/#product",
      "name": {{ product.title | json }},
      "description": {{ product.description | strip_html | truncate: 500 | json }},
      "url": "{{ shop.url }}/products/{{ product.handle }}",
      "sku": {{ product.selected_or_first_available_variant.sku | default: product.id | json }},
      "encodingFormat": "application/pdf",
      "brand": {
        "@type": "Brand",
        "name": {{ shop.name | json }}
      },
      "audience": {
        "@type": "PeopleAudience",
        "suggestedGender": "female",
        "suggestedMinAge": 30,
        "suggestedMaxAge": 60
      },
      "offers": {
        "@type": "Offer",
        "url": "{{ shop.url }}/products/{{ product.handle }}",
        "priceCurrency": {{ cart.currency.iso_code | json }},
        "price": {{ product.selected_or_first_available_variant.price | divided_by: 100.0 | json }},
        "availability": "https://schema.org/InStock",
        "itemCondition": "https://schema.org/NewCondition",
        "seller": { "@id": "{{ shop.url }}/#organization" },
        "hasMerchantReturnPolicy": {
          "@type": "MerchantReturnPolicy",
          "applicableCountry": "IE",
          "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
          "merchantReturnDays": 7,
          "returnMethod": "https://schema.org/ReturnByMail",
          "returnFees": "https://schema.org/FreeReturn"
        },
        "shippingDetails": {
          "@type": "OfferShippingDetails",
          "shippingRate": {
            "@type": "MonetaryAmount",
            "value": "0",
            "currency": "EUR"
          },
          "deliveryTime": {
            "@type": "ShippingDeliveryTime",
            "handlingTime": {
              "@type": "QuantitativeValue",
              "minValue": 0,
              "maxValue": 0,
              "unitCode": "DAY"
            },
            "transitTime": {
              "@type": "QuantitativeValue",
              "minValue": 0,
              "maxValue": 0,
              "unitCode": "DAY"
            }
          }
        }
      }
      {%- if product.featured_image -%}
      ,"image": [
        "https:{{ product.featured_image | image_url: width: 1200 }}"
      ]
      {%- endif -%}
    }
    {%- endif -%}
    {%- if request.page_type == 'collection' -%}
    ,{
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": {{ shop.url | json }}
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": {{ collection.title | json }},
          "item": "{{ shop.url }}{{ collection.url }}"
        }
      ]
    }
    {%- endif -%}
  ]
}
</script>
